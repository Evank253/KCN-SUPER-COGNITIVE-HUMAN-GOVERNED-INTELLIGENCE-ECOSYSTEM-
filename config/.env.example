# Application
APP_NAME=KCN-Ecosystem
APP_VERSION=0.1.0
APP_ENV=development
APP_DEBUG=true

# API
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1

# Security — change these before any real deployment
JWT_SECRET_KEY=change-me-to-a-secure-random-string-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# GitHub OAuth — admin sign-in (see docs/VERCEL_SETUP.md / DEPLOYMENT.md for setup)
# Register an OAuth App at https://github.com/settings/developers
# Authorization callback URL must exactly match GITHUB_OAUTH_REDIRECT_URI below.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback
# Comma-separated GitHub usernames allowed to sign in as admin
GITHUB_ADMIN_USERNAMES=Evank253
# Where the backend sends the browser back to after GitHub OAuth completes
FRONTEND_URL=http://localhost:5173

# Database (Phase 2)
# DATABASE_URL=******localhost:5432/kcn
# DATABASE_POOL_SIZE=10

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Frontend
VITE_API_BASE_URL=/api/v1
